{
  "name": "fire-protection-digital-twin",
  "productName": "Fire Protection Digital Twin",
  "version": "1.0.0",
  "description": "Educational real-time fire-fighting system digital twin simulator (sprinklers, fire pumps, standpipes, clean agent, foam).",
  "author": "ASFAN Trading <info@asfanco.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build:renderer": "node tools/build.mjs",
    "start": "npm run build:renderer && electron .",
    "test": "node --test \"tests/*.test.mjs\"",
    "license:init": "node tools/license-tool.mjs init",
    "license:issue": "node tools/license-tool.mjs issue",
    "dist:win": "npm run build:renderer && electron-builder --win nsis portable --x64 --publish never",
    "dist:dir": "npm run build:renderer && electron-builder --win dir --x64"
  },
  "build": {
    "appId": "com.asfan.firetwin",
    "productName": "Fire Protection Digital Twin",
    "copyright": "© 2026 ASFAN Trading",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "app/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fire Protection Digital Twin",
      "artifactName": "FireProtectionDigitalTwin-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "FireProtectionDigitalTwin-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "three": "^0.169.0"
  }
}
